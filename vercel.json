{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.webmanifest", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/index.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/index.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/db-info", "dest": "/api/db-info.js" },
    { "src": "/api/neon", "dest": "/api/neon.js" },
    { "src": "/api/billing", "dest": "/api/billing.js" },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook.js" },
    { "src": "/api/supabase-proxy", "dest": "/api/supabase-proxy.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
