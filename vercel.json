{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/index.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/owner-signup.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-owner-signup.html" },
    { "src": "/merchant.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-merchant.html" },
    { "src": "/join.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-join.html" },
    { "src": "/customer.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-customer.html" },
    { "src": "/", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/index.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel.html" },
    { "src": "/owner-signup.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-owner-signup.html" },
    { "src": "/merchant.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-merchant.html" },
    { "src": "/join.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-join.html" },
    { "src": "/customer.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-customer.html" },
    { "src": "/terms.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-terms.html" },
    { "src": "/privacy.html", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-privacy.html" },
    { "src": "/robots.txt", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-robots.txt" },
    { "src": "/sitemap.xml", "has": [{ "type": "host", "value": "loyaltyapp.company" }], "dest": "/israel-sitemap.xml" },
    { "src": "/terms.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-terms.html" },
    { "src": "/privacy.html", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-privacy.html" },
    { "src": "/robots.txt", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-robots.txt" },
    { "src": "/sitemap.xml", "has": [{ "type": "host", "value": "www.loyaltyapp.company" }], "dest": "/israel-sitemap.xml" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/db-info", "dest": "/api/db-info.js" },
    { "src": "/api/neon", "dest": "/api/neon.js" },
    { "src": "/api/crm", "dest": "/api/crm.js" },
    { "src": "/api/billing", "dest": "/api/billing.js" },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook.js" },
    { "src": "/api/supabase-proxy", "dest": "/api/supabase-proxy.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
